any;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_custom_requests_quotes_21" value="review → price" edge="1" parent="1" source="tbl_custom_requests" target="tbl_quotes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERone;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_orders_order_items_22" value="contains" edge="1" parent="1" source="tbl_orders" target="tbl_order_items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_orders_payment_attempts_23" value="attempts" edge="1" parent="1" source="tbl_orders" target="tbl_payment_attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_orders_order_status_history_24" value="tracking" edge="1" parent="1" source="tbl_orders" target="tbl_order_status_history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="overviewnote" value="&lt;b&gt;Two purchasing sources — one OrderItem model&lt;/b&gt;&lt;br/&gt;CATALOG: product_variant → browser cart → catalog order → order_items&lt;br/&gt;CUSTOM: submitted request → admin review → single quote → accepted quote → custom order → order_items&lt;br/&gt;Both: payment attempts → fulfillment → delivery → order-item review" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#F8FAFC;strokeColor=#D8E0EA;strokeWidth=1;fontColor=#425466;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1030" width="1980" height="172" as="geometry"/></mxCell><mxCell id="overviewnote2" value="&lt;b&gt;Reading tip&lt;/b&gt;&lt;br/&gt;This is a logical map; not every FK arrow is shown here to avoid visual clutter. Open pages 02, 03, 04 and 05 for field-level details and the complete foreign-key index." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#F8FAFC;strokeColor=#D8E0EA;strokeWidth=1;fontColor=#425466;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2210" y="1030" width="1340" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="02 - Catalog ERD" id="diag1"><mxGraphModel dx="2560" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;div style=&quot;font-size:26px&quot;&gt;&lt;b&gt;Catalog | Products &amp;amp; variants&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b&quot;&gt;One product has many variants and images. Catalog checkout uses a browser cart, NOT database cart tables.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#11263C;spacing=5;" vertex="1" parent="1"><mxGeometry x="65" y="34" width="2430" height="75" as="geometry"/></mxCell><mxCell id="tbl_categories" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;categories&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;name / slug UNIQUE&lt;br/&gt;is_active  boolean&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E8F7F1;strokeColor=#187C68;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="380" height="133" as="geometry"/></mxCell><mxCell id="tbl_products" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;products&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;category_id  FK → categories (nullable)&lt;br/&gt;title / description&lt;br/&gt;is_active  boolean&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E8F7F1;strokeColor=#187C68;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="625" y="240" width="405" height="158" as="geometry"/></mxCell><mxCell id="tbl_product_variants" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;product_variants&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;product_id  FK → products&lt;br/&gt;sku  UNIQUE&lt;br/&gt;material / color&lt;br/&gt;price_minor  bigint&lt;br/&gt;currency  char(3)&lt;br/&gt;is_active  boolean&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E8F7F1;strokeColor=#187C68;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="1190" y="240" width="450" height="233" as="geometry"/></mxCell><mxCell id="tbl_order_items" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;order_items&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;order_id  FK → orders&lt;br/&gt;source_type  CATALOG | CUSTOM&lt;br/&gt;product_variant_id?  FK → product_variants&lt;br/&gt;quote_id?  FK → quotes UNIQUE&lt;br/&gt;quantity / title_snapshot&lt;br/&gt;unit_price_minor&lt;br/&gt;design_fee_minor / line_total_minor&lt;br/&gt;material_snapshot / color_snapshot?&lt;br/&gt;CHECK: exactly one source FK&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#F0ECFF;strokeColor=#6A55AA;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="1810" y="240" width="520" height="308" as="geometry"/></mxCell><mxCell id="tbl_product_images" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;product_images&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;product_id  FK → products&lt;br/&gt;storage_key / alt_text&lt;br/&gt;sort_order  integer&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E8F7F1;strokeColor=#187C68;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="625" y="770" width="405" height="158" as="geometry"/></mxCell><mxCell id="edge_categories_products_8" value="optional category" edge="1" parent="1" source="tbl_categories" target="tbl_products" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_products_product_variants_9" value="1 : many" edge="1" parent="1" source="tbl_products" target="tbl_product_variants" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_products_product_images_10" value="1 : many" edge="1" parent="1" source="tbl_products" target="tbl_product_images" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_product_variants_order_items_11" value="catalog source" edge="1" parent="1" source="tbl_product_variants" target="tbl_order_items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="catalognote" value="Price rule: backend reads current active variant price at checkout and snapshots it into order_items. Publishing product requires an image + at least one active variant. Do not hard-delete sold variants." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#F8FAFC;strokeColor=#D8E0EA;strokeWidth=1;fontColor=#425466;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1220" width="2200" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 - Custom request &amp; quote ERD" id="diag2"><mxGraphModel dx="2720" dy="1490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="1490" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;div style=&quot;font-size:26px&quot;&gt;&lt;b&gt;Custom manufacturing | Request → Quote&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b&quot;&gt;BROKEN_PART and FROM_IMAGE are values of custom_requests.type. Only one Quote per Request.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#11263C;spacing=5;" vertex="1" parent="1"><mxGeometry x="65" y="34" width="2590" height="75" as="geometry"/></mxCell><mxCell id="tbl_users" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;full_name  varchar(150)&lt;br/&gt;phone  varchar(20)&lt;br/&gt;is_verified  boolean&lt;br/&gt;email  varchar(255) UNIQUE&lt;br/&gt;password_hash  text&lt;br/&gt;role  CUSTOMER | ADMIN&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E9F2FF;strokeColor=#3465A4;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="410" height="208" as="geometry"/></mxCell><mxCell id="tbl_custom_requests" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;custom_requests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;customer_id  FK → users&lt;br/&gt;type  BROKEN_PART | FROM_IMAGE&lt;br/&gt;title / description / quantity&lt;br/&gt;usage_context  text&lt;br/&gt;device_brand / device_model?&lt;br/&gt;measurements  jsonb (nullable)&lt;br/&gt;delivery_city / region?&lt;br/&gt;status  see transition guide&lt;br/&gt;review_note / rejection_reason?&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#FFF2E1;strokeColor=#A26315;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="640" y="245" width="515" height="333" as="geometry"/></mxCell><mxCell id="tbl_request_attachments" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;request_attachments&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;request_id  FK → custom_requests&lt;br/&gt;storage_key / filename&lt;br/&gt;mime_type / size_bytes&lt;br/&gt;created_at&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#FFF2E1;strokeColor=#A26315;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="1330" y="130" width="460" height="183" as="geometry"/></mxCell><mxCell id="tbl_quotes" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;quotes&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;custom_request_id  FK UNIQUE&lt;br/&gt;prepared_by_admin_id  FK → users&lt;br/&gt;quantity / material&lt;br/&gt;design_fee_minor&lt;br/&gt;unit_price_minor&lt;br/&gt;shipping_fee_minor&lt;br/&gt;total_minor (calculated)&lt;br/&gt;currency = SYP / estimated_days&lt;br/&gt;status / expires_at (7d)&lt;br/&gt;created_at&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#FFF2E1;strokeColor=#A26315;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="1330" y="770" width="485" height="333" as="geometry"/></mxCell><mxCell id="tbl_order_items" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;order_items&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;order_id  FK → orders&lt;br/&gt;source_type  CATALOG | CUSTOM&lt;br/&gt;product_variant_id?  FK → product_variants&lt;br/&gt;quote_id?  FK → quotes UNIQUE&lt;br/&gt;quantity / title_snapshot&lt;br/&gt;unit_price_minor&lt;br/&gt;design_fee_minor / line_total_minor&lt;br/&gt;material_snapshot / color_snapshot?&lt;br/&gt;CHECK: exactly one source FK&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#F0ECFF;strokeColor=#6A55AA;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="2030" y="770" width="500" height="308" as="geometry"/></mxCell><mxCell id="edge_users_custom_requests_8" value="customer" edge="1" parent="1" source="tbl_users" target="tbl_custom_requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_custom_requests_request_attachments_9" value="photos" edge="1" parent="1" source="tbl_custom_requests" target="tbl_request_attachments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERmany;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="420"/><mxPoint x="1240" y="300"/></Array></mxGeometry></mxCell><mxCell id="edge_custom_requests_quotes_10" value="0 or 1 quote" edge="1" parent="1" source="tbl_custom_requests" target="tbl_quotes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERone;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="610"/><mxPoint x="1230" y="950"/></Array></mxGeometry></mxCell><mxCell id="edge_quotes_order_items_11" value="unique custom item" edge="1" parent="1" source="tbl_quotes" target="tbl_order_items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#64748B;startArrow=ERone;endArrow=ERone;startFill=0;endFill=0;fontSize=12;fontColor=#415367;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="customnote" value="Lifecycle: SUBMITTED → UNDER_REVIEW → NEEDS_INFO → SUBMITTED (resubmit), or REJECTED / QUOTED. Admin can issue Quote only from UNDER_REVIEW. Quote remains immutable, expires after 7 days, and acceptance creates one CUSTOM Order. users → quotes.prepared_by_admin_id is documented in the FK Index tab." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#F8FAFC;strokeColor=#D8E0EA;strokeWidth=1;fontColor=#425466;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1190" width="2460" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 - Orders &amp; payments ERD" id="diag3"><mxGraphModel dx="2840" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;div style=&quot;font-size:26px&quot;&gt;&lt;b&gt;Orders | Single order_items model&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b&quot;&gt;All catalog parts printed on demand. Delivery statuses replace QUALITY_CHECK. A review belongs to each order item.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#11263C;spacing=5;" vertex="1" parent="1"><mxGeometry x="65" y="34" width="2710" height="75" as="geometry"/></mxCell><mxCell id="tbl_users" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family:monospace;font-size:12px;line-height:1.75&quot;&gt;id  UUID  PK&lt;br/&gt;full_name  varchar(150)&lt;br/&gt;phone  varchar(20)&lt;br/&gt;is_verified  boolean&lt;br/&gt;email  varchar(255) UNIQUE&lt;br/&gt;password_hash  text&lt;br/&gt;role  CUSTOMER | ADMIN&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=17;spacingTop=13;spacingRight=10;fillColor=#E9F2FF;strokeColor=#3465A4;strokeWidth=2;fontColor=#1F2937;shadow=0;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="400" height="208" as="geometry"/></mxCell><mxCell id="tbl_orders" value="&lt;div style=&quot;font-size:18px&quot;&gt;&lt;b&gt;orders&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/div&gt;&l